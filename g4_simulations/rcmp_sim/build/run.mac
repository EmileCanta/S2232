/process/em/auger true # auger electrons
/process/em/pixe true # particle induced X-ray emission
/control/verbose 2
/run/verbose 2
/event/verbose 0
/tracking/verbose 0
/run/initialize
/Histo/RecordGun true
/DetSys/world/material Vacuum
/DetSys/det/addRCMP
/DetSys/gun/BeamSpot 2.5 mm
#/DetSys/gun/coneMaxAngle 90 deg
#/DetSys/gun/coneMinAngle 0 deg
/DetSys/gun/position 0.0 0.0 4.0 mm
/gun/particle geantino
/DetSys/gun/efficiencyEnergy 1. MeV
/run/beamOn 1000000

