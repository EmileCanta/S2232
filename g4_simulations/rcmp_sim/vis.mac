/run/initialize

/process/had/rdm/nucleusLimits 241 241 95 95
/process/had/rdm/thresholdForVeryLongDecayTime 1e19 s

/process/em/fluo false
/process/em/pixe false
/process/em/auger false

/DetSys/world/material Vacuum

#/DetSys/det/includeGriffinHevimet 1
#/DetSys/det/addGriffinBack 16
#/DetSys/det/addSceptar 20
/DetSys/det/addRCMP

/vis/filtering/trajectories/create/particleFilter
/vis/filtering/trajectories/particleFilter-0/add gamma
/vis/filtering/trajectories/particleFilter-0/add e-
/vis/filtering/trajectories/particleFilter-0/add e+
/vis/filtering/trajectories/particleFilter-0/add proton
/vis/filtering/trajectories/particleFilter-0/add photon
/vis/filtering/trajectories/particleFilter-0/add alpha
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/set e- yellow
/vis/modeling/trajectories/drawByParticleID-0/set e+ magenta
/vis/modeling/trajectories/drawByParticleID-0/set proton red
/vis/modeling/trajectories/drawByParticleID-0/set photon white
/vis/modeling/trajectories/drawByParticleID-0/set alpha cyan

/tracking/storeTrajectory 1
/vis/open OGL
#/vis/open OGLIQt
/vis/drawVolume
/vis/viewer/set/autoRefresh true
/vis/scene/add/trajectories smooth
/vis/scene/add/axes 0 0 0 10 cm
/vis/viewer/set/targetPoint 0 0 0 m
/vis/viewer/set/style surface
/vis/scene/endOfEventAction accumulate 10000

/Histo/RecordGun true

/DetSys/gun/BeamSpot 2.5 mm
#/DetSys/gun/coneMaxAngle 90 deg
#/DetSys/gun/coneMinAngle 0 deg
/DetSys/gun/position 0.0 0.0 3.9 mm

#/gun/particle ion
#/gun/ion 95 241

/gun/particle alpha

/DetSys/gun/efficiencyEnergy 4.5 MeV

/run/beamOn 100
